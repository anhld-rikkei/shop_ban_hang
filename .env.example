# Copy to .env.local and change the values before exposing the site.

# Admin account for /admin (defaults: admin / admin123 when unset — development only)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Optional: SQLite database file (defaults to ./data/lienstore.db; in Docker /app/data/lienstore.db)
# LIEN_DB_PATH=./data/lienstore.db
# Optional: seed catalogue imported when the database is empty (defaults to ./data/seed.json)
# LIEN_SEED_PATH=./data/seed.json

# Public site URL used in robots.txt / sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Facebook Messenger customer chat (original site uses page 100282411711448). Leave empty to disable.
NEXT_PUBLIC_FB_PAGE_ID=
